{
  "name": "@aster/desktop",
  "productName": "Aster",
  "version": "1.0.5",
  "private": true,
  "description": "Aster Kubernetes desktop workbench",
  "author": "Aster contributors",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:core && pnpm build:renderer",
    "dev": "pnpm build:core && tauri dev",
    "dist": "pnpm build:core && tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:rust",
    "smoke:visual": "playwright test",
    "record:landing": "node scripts/record-landing.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pierre/diffs": "^1.3.5",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
